// bitmaps.rc -- 工具条/标签页/树图标位图
// 前 5 张由 tools\extract_icons.py 从 e.exe 的 RT_BITMAP 原样导出（洋红透明色已换成 COLOR_BTNFACE）；
// tree_icons.bmp 是从原版截图 shots\ide_orig_current.png 抠的（e.exe 里没有这组图标，来自 krnln.fne）。
IDB_TOOLBAR_STD     BITMAP  "res/toolbar_std.bmp"       // 131 标准工具条 23 钮
IDB_TOOLBAR_ALIGN   BITMAP  "res/toolbar_align.bmp"     // 297 对齐工具条 14 钮（原版这行是灰的，297 就是灰版）
IDB_TOOLBAR_POS     BITMAP  "res/toolbar_pos.bmp"       // 231 定位工具条 17 钮（默认收起）
IDB_TABICON_WORK    BITMAP  "res/tabicons_work.bmp"     // 146 工作夹标签图标 x7（已补成 16 行）
IDB_TABICON_STATUS  BITMAP  "res/tabicons_status.bmp"   // 148 状态夹标签图标 x7
IDB_TREE_ICONS      BITMAP  "res/tree_icons.bmp"        // 支持库树图标 x24
// 「程序」页树的节点图标：e.exe 里没有这组资源，从原版 1:1 截图抠的（tools\extract_progtree_icons.py）
IDB_PROGTREE_ICONS  BITMAP  "res/progtree_icons.bmp"    // 程序树图标 x15
// 程序图标（e.exe 的 RT_GROUP_ICON 126 = 16/32/48）。MDI 子窗口最大化时 Windows 会把它
// 画在父窗口菜单条最左端 —— 原版那个"易"就是这么来的，不是单独画的装饰。
IDR_MAINFRAME       ICON    "res/eclone.ico"

// ---- 代码编辑器「流程线」图元（e.exe 的 RT_BITMAP 原样导出，数值=原资源 ID）----
// 原版把这些贴出来的方式见伪 C：sub_4CA030(dc, x, y, 位图, 图元, 0, 0xFF000000) ——
// 0xFF000000 是透明色键。拐角方向在 sub_4B80E0 里选：向下→0xA3，向上→0xE4，横向→0xA2。
IDB_ECFLOW_9D       BITMAP  "res/ecflow_9D.bmp"
IDB_ECFLOW_9E       BITMAP  "res/ecflow_9E.bmp"
IDB_ECFLOW_9F       BITMAP  "res/ecflow_9F.bmp"
IDB_ECFLOW_A2       BITMAP  "res/ecflow_A2.bmp"
IDB_ECFLOW_A3       BITMAP  "res/ecflow_A3.bmp"
IDB_ECFLOW_E1       BITMAP  "res/ecflow_E1.bmp"
IDB_ECFLOW_E4       BITMAP  "res/ecflow_E4.bmp"
IDB_ECFLOW_23F      BITMAP  "res/ecflow_23F.bmp"
IDB_ECFLOW_241      BITMAP  "res/ecflow_241.bmp"
IDB_ECFLOW_E6       BITMAP  "res/ecflow_E6.bmp"
