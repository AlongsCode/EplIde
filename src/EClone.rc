// ---------------- ec_syscfg.rc ----------------
// ec_syscfg.rc -- 「系统配置」对话框模板
//
// 对照原版 e.exe 的 RT_DIALOG id=282（267x217 对话框单位、78 个控件、
// SysTabControl32 id=1149）。
//
// ★ 页名、每页属于哪些控件：**原版运行时实测**，不是推的 ——
//   `powershell -File tools\probe_cfgrets.ps1` 会起一份原版、打开这个对话框，
//   用真鼠标逐个点 7 个页签，倒出「每页可见控件」的**屏幕坐标**
//   （结果存在 shots\live_syscfg\rects.txt）。实测结果：
//     [0] 通常  1116/1115/1118/1101/1102/1041/1042/1001/1011/1251/1236/1242
//     [1] 编 辑 1117/1127/1128/1129/8/1130/1180/1132/1200/1201   （默认输入法 + 编辑行为）
//     [2] 显示  128/129/1155/149/1135/1137/1139/1122/1004/1124/10/1120/531/11/9/1142/5
//     [3] 设计  1126/1133/1006/1007/1144/1134/1008/1145/1009/1146/1147
//     [4] 编译  1165/1166/1168/1169/1170/1136/1140/1138/1141/1240/1235/1241
//     [5] 存根  1103/1208/1207/1104/1246/1010
//     [6] 安全  1197/1198/1167/612/613/614
//   ⚠️ 模板里的**建立次序不是分页次序**（比如「默认输入法」那一组在 id=282 的第 12 行，
//      却属于第 1 页）。所以页名/归属只能靠运行时实测，别照模板顺序猜。
//   ⚠️ 页签文字也不在资源里（模板里只有占位 "Tab3"）：页名是从原版截图放大读出来的
//      （shots\live_syscfg\tabs_zoom2.png）：通常 / 编 辑 / 显示 / 设计 / 编译 / 存根 / 安全。
//   ⚠️ 第 21 轮以前这里写的是「安全/存根/编译/设计/显示/编辑」（6 个页，名字和次序都错）。
//
// 坐标/尺寸/文字全部照 tools\dump_dialogs.py 的输出（shots\e_dialogs.txt 的 DIALOG id=282）
// 抄；一条命令列全：`python tools\dlg_list.py 282`。
// 控件 id 沿用原版编号（动态文字用本工程自留的 22xx 段，见 resource.h 的说明）。

IDD_SYSCFG DIALOGEX 0, 0, 272, 218
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "系统配置"
FONT 9, "宋体"
BEGIN
    CONTROL         "", ID_SYSCFG_TAB, "SysTabControl32",
                    WS_CHILD | WS_VISIBLE | WS_CLIPSIBLINGS | TCS_TABS,
                    6, 5, 260, 187

    // ================= [0] 通常 =================
    GROUPBOX        "Windows 窗口程序启动方式", IDC_CFG_G1, 13, 25, 183, 47
    LTEXT           "系统自动保存编辑现场的间隔时间（分钟），为 0 禁止：", 2210, 15, 115, 209, 8
    LTEXT           "支持撤消功能时可用内存尺寸（千字节），为 0 不限制：", 2211, 15, 131, 212, 8
    CONTROL         "通过名称为“_启动窗口”的窗口启动", IDC_CFG_STARTWIN, "Button",
                    BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP, 22, 41, 168, 8
    CONTROL         "通过名称为“_启动子程序”的子程序启动", IDC_CFG_STARTSUB, "Button",
                    BS_AUTORADIOBUTTON | WS_TABSTOP, 22, 55, 168, 8
    CONTROL         "程序存盘时是否保存 .BAK 备份文件", IDC_CFG_BAK, "Button",
                    BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP, 15, 83, 173, 8
    CONTROL         "编译发布版本时是否保存入作者信息", IDC_CFG_AUTHOR, "Button",
                    BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP, 15, 99, 236, 8
    EDITTEXT        IDC_CFG_SAVEMIN,                  228, 113, 31, 12, ES_AUTOHSCROLL | WS_BORDER
    EDITTEXT        IDC_CFG_UNDOMEM,                  228, 127, 31, 12, ES_AUTOHSCROLL | WS_BORDER
    LTEXT           "调试编译输出文件名(为空表示使用系统默认文件名):", 2212, 15, 147, 194, 8
    EDITTEXT        IDC_CFG_DEBUGOUT,                 26, 161, 212, 12, ES_AUTOHSCROLL | WS_BORDER
    PUSHBUTTON      "...", IDC_CFG_DEBUGBROWSE,       239, 161, 17, 12

    // ================= [1] 编 辑（默认输入法 + 编辑行为） =================
    GROUPBOX        "默认输入法", IDC_CFG_G2,         23, 35, 110, 63
    CONTROL         "首拼及全拼", IDC_CFG_IM1, "Button",
                    BS_AUTORADIOBUTTON | WS_TABSTOP, 33, 51, 79, 8
    CONTROL         "双拼", IDC_CFG_IM2, "Button",
                    BS_AUTORADIOBUTTON | WS_TABSTOP, 33, 65, 79, 8
    CONTROL         "英文", IDC_CFG_IM3, "Button",
                    BS_AUTORADIOBUTTON | WS_TABSTOP, 33, 79, 79, 8
