@echo off
rem ---------------------------------------------------------------
rem  EClone build (VC6 / MFC 4.2, static link)
rem  sources : <root>\src   (UTF-8, hand edited)
rem  build in: <root>\gbk   (GBK, generated by tools\utf8togbk.ps1)
rem  output  : <root>\bin\EClone.exe
rem  <root> = the directory this .bat lives in (was hard-coded to D:\eclone;
rem           the tree may live elsewhere, e.g. on the Desktop -- keep it relative)
rem ---------------------------------------------------------------
setlocal
set ROOT=%~dp0
if "%ROOT:~-1%"=="\" set ROOT=%ROOT:~0,-1%
set VC98=C:\Program Files (x86)\Microsoft Visual Studio\VC98
set MSDEV=C:\Program Files (x86)\Microsoft Visual Studio\Common\MSDev98
set PATH=%VC98%\Bin;%MSDEV%\Bin;%PATH%
rem ATL\Include ?? MFC ? afxpriv.h->afxconv.h->atlconv.h ???sizecbar ? include afxpriv.h?
set INCLUDE=%VC98%\Include;%VC98%\MFC\Include;%VC98%\ATL\Include
set LIB=%VC98%\Lib;%VC98%\MFC\Lib

if not exist "%ROOT%\bin" mkdir "%ROOT%\bin"

python "%ROOT%\tools\assemble_rc.py"
if errorlevel 1 goto :fail

powershell -NoProfile -ExecutionPolicy Bypass -File "%ROOT%\tools\utf8togbk.ps1" -SrcDir "%ROOT%\src" -DstDir "%ROOT%\gbk"
if errorlevel 1 goto :fail

rem ---- guard: a "//" comment whose GBK bytes contain the block-comment terminator
rem      silently eats the next statement (see HANDOFF round 16). Fail the build.
python "%ROOT%\tools\check_block_comments.py" "%ROOT%\gbk"
if errorlevel 1 goto :fail

cd /d "%ROOT%\gbk"
if errorlevel 1 goto :fail
if exist *.obj del /q *.obj
if exist *.res del /q *.res

rem ---- compile ----
cl /nologo /c /MT /GX /O2 /W3 *.cpp
if errorlevel 1 goto :fail

rem ---- resources (optional) ----
set RES=
if exist EClone.rc (
  rc /fo EClone.res EClone.rc
  if errorlevel 1 goto :fail
  set RES=EClone.res
)

rem ---- link ----
link /nologo /subsystem:windows /out:"%ROOT%\bin\EClone.exe" *.obj %RES% ^
  nafxcw.lib libcmt.lib oldnames.lib ^
  kernel32.lib user32.lib gdi32.lib winmm.lib msimg32.lib winspool.lib ^
  comdlg32.lib advapi32.lib shell32.lib ole32.lib oleaut32.lib comctl32.lib imm32.lib
if errorlevel 1 goto :fail

echo BUILD OK
goto :eof
:fail
echo BUILD FAILED
exit /b 1
